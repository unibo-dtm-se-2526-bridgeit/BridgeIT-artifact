{
  "components": {
    "schemas": {
      "AnalysisBody": {
        "properties": {
          "issues": {
            "items": {
              "type": "string"
            },
            "title": "Issues",
            "type": "array"
          },
          "quality_indication": {
            "title": "Quality Indication",
            "type": "string"
          }
        },
        "required": [
          "quality_indication",
          "issues"
        ],
        "title": "AnalysisBody",
        "type": "object"
      },
      "AnalysisResponse": {
        "properties": {
          "analysis": {
            "$ref": "#/components/schemas/AnalysisBody"
          },
          "requirement_id": {
            "title": "Requirement Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "status",
          "analysis"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RequirementCreateRequest": {
        "description": "Request body for submitting a new requirement (FR-01).\n\nThis is a Data Transfer Object (DTO): it validates and shapes data\ncoming from the HTTP boundary. It is intentionally distinct from the\ndomain `Requirement` entity (see architecture.md \u2014 Dependency Rules):\nthe API must never expose domain objects directly. It lives in the\ndriving adapter (not in the application layer) because it depends on\nPydantic, an HTTP-boundary concern.",
        "properties": {
          "text": {
            "description": "The natural-language text of the requirement being submitted.",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "RequirementCreateRequest",
        "type": "object"
      },
      "RequirementResponse": {
        "description": "Response body representing a Requirement's current state to API clients.\n\nDistinct from the domain `Requirement` entity for the same reason as\n`RequirementCreateRequest` above: it is the API's own view of a\nrequirement, shaped for HTTP clients, not the domain's internal\nrepresentation.",
        "properties": {
          "id": {
            "description": "Unique identifier of the requirement.",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "description": "Current lifecycle status of the requirement (e.g. Submitted, Analyzed, Clarified, Validated, Rejected).",
            "title": "Status",
            "type": "string"
          },
          "text": {
            "description": "Current text of the requirement.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "status"
        ],
        "title": "RequirementResponse",
        "type": "object"
      },
      "ValidateRequest": {
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "modified_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modified Text"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "ValidateResponse": {
        "properties": {
          "requirement_id": {
            "title": "Requirement Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "status"
        ],
        "title": "ValidateResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BridgeIT",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Health check endpoint: confirms the service is up and responding.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/requirements": {
      "post": {
        "description": "Submit a new requirement (FR-01).",
        "operationId": "create_requirement_api_v1_requirements_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequirementCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequirementResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Requirement"
      }
    },
    "/api/v1/requirements/{requirement_id}": {
      "get": {
        "description": "Retrieve a requirement by id.",
        "operationId": "get_requirement_api_v1_requirements__requirement_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "requirement_id",
            "required": true,
            "schema": {
              "title": "Requirement Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequirementResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Requirement"
      }
    },
    "/api/v1/requirements/{requirement_id}/analyse": {
      "post": {
        "description": "Request an AI-assisted analysis of a requirement (FR-02, FR-04).",
        "operationId": "analyse_requirement_api_v1_requirements__requirement_id__analyse_post",
        "parameters": [
          {
            "in": "path",
            "name": "requirement_id",
            "required": true,
            "schema": {
              "title": "Requirement Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyse Requirement"
      }
    },
    "/api/v1/requirements/{requirement_id}/validate": {
      "post": {
        "description": "Record a human validation decision for a requirement (FR-05).",
        "operationId": "validate_requirement_api_v1_requirements__requirement_id__validate_post",
        "parameters": [
          {
            "in": "path",
            "name": "requirement_id",
            "required": true,
            "schema": {
              "title": "Requirement Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate Requirement"
      }
    }
  }
}
